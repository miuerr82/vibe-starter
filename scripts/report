#!/usr/bin/env bash

set -euo pipefail

source "$(cd "$(dirname "$0")" && pwd)/lib/common.sh"

bootstrap_starter "$@"

OPEN_AFTER_GENERATE="false"

if [[ ${#STARTER_ARGS[@]} -gt 0 ]]; then
  for arg in "${STARTER_ARGS[@]}"; do
    case "${arg}" in
      --open|-o)
        OPEN_AFTER_GENERATE="true"
        ;;
      --help|-h)
        print_line "用法：bash ./vibe-coding/vibe-starter/scripts/report [--open] [--project-root <path>]"
        exit 0
        ;;
      *)
        fail "不支援的 report 參數：${arg}"
        ;;
    esac
  done
fi

ensure_report_source_files() {
  ensure_dir "${REPORTS_DIR}"
  ensure_dir "${REPORT_DATA_DIR}"
  ensure_dir "${REPORT_HTML_DIR}"

  if [[ ! -e "${REPORT_DATA_DIR}/project-state.yml" ]]; then
    cp "${STARTER_ROOT}/templates/reports/data/project-state.yml" "${REPORT_DATA_DIR}/project-state.yml"
  fi

  if [[ ! -e "${REPORTS_DIR}/current-status.md" ]]; then
    cp "${STARTER_ROOT}/templates/reports/current-status.md" "${REPORTS_DIR}/current-status.md"
  fi
}

open_dashboard() {
  local html_path="$1"
  local open_status="無可用開啟指令，請手動開啟：${html_path}"

  if command -v wslview >/dev/null 2>&1; then
    wslview "${html_path}" >/dev/null 2>&1 &
    open_status="已嘗試使用 wslview 開啟。"
  elif command -v explorer.exe >/dev/null 2>&1 && command -v wslpath >/dev/null 2>&1; then
    explorer.exe "$(wslpath -w "${html_path}")" >/dev/null 2>&1 &
    open_status="已嘗試使用 explorer.exe 開啟。"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "${html_path}" >/dev/null 2>&1 &
    open_status="已嘗試使用 xdg-open 開啟。"
  elif command -v open >/dev/null 2>&1; then
    open "${html_path}" >/dev/null 2>&1 &
    open_status="已嘗試使用 open 開啟。"
  fi

  print_line "${open_status}"
}

render_dashboard() {
  if ! command -v python3 >/dev/null 2>&1; then
    fail "找不到 python3，無法產生 HTML report。"
  fi

  export PROJECT_ROOT
  python3 - <<'PY'
from __future__ import annotations

from datetime import datetime
from html import escape
from pathlib import Path
import os
import re

project_root = Path(os.environ["PROJECT_ROOT"])
reports_root = project_root / "vibe-coding" / "reports"
state_path = reports_root / "data" / "project-state.yml"
status_path = reports_root / "current-status.md"
html_path = reports_root / "html" / "index.html"

state_text = state_path.read_text(encoding="utf-8")
status_text = status_path.read_text(encoding="utf-8")


def first_match(pattern: str, text: str) -> str:
    match = re.search(pattern, text, re.MULTILINE)
    if not match:
        return ""
    return match.group(1).strip().strip('"').strip("'")


def top_level_block(name: str, text: str) -> str:
    pattern = rf"^{re.escape(name)}:\n(?P<body>(?:[ \t].*\n|[ \t]*\n)*)"
    match = re.search(pattern, text, re.MULTILINE)
    if not match:
        return ""
    return match.group("body").rstrip()


def nested_scalar(block: str, key: str) -> str:
    return first_match(rf"^[ \t]+{re.escape(key)}:[ \t]*(.*)$", block)


def markdown_snapshot_time(text: str) -> str:
    return first_match(r"^(?:彙整時間|summarized_at)[ \t]*[：:][ \t]*(.*)$", text)


project_block = top_level_block("project", state_text)
source_summarized_at = first_match(r"^summarized_at:[ \t]*(.*)$", state_text) or markdown_snapshot_time(status_text) or "未記錄"
generated_at = datetime.now().astimezone().isoformat(timespec="seconds")

project_name = nested_scalar(project_block, "name") or "未命名專案"
project_goal = nested_scalar(project_block, "goal") or "未記錄"
current_status = nested_scalar(project_block, "current_status") or "未記錄"
current_milestone = nested_scalar(project_block, "current_milestone") or "未記錄"
updated_at = nested_scalar(project_block, "updated_at") or "未記錄"


def render_table(lines: list[str]) -> str:
    rows = []
    for line in lines:
        stripped = line.strip()
        if not stripped.startswith("|") or not stripped.endswith("|"):
            continue
        cells = [cell.strip() for cell in stripped.strip("|").split("|")]
        if all(re.fullmatch(r":?-{3,}:?", cell) for cell in cells):
            continue
        rows.append(cells)
    if not rows:
        return ""
    head = rows[0]
    body = rows[1:]
    html = ["<div class=\"table-wrap\"><table><thead><tr>"]
    html.extend(f"<th>{escape(cell)}</th>" for cell in head)
    html.append("</tr></thead><tbody>")
    for row in body:
        html.append("<tr>")
        html.extend(f"<td>{escape(cell)}</td>" for cell in row)
        html.append("</tr>")
    html.append("</tbody></table></div>")
    return "".join(html)


def render_markdown(text: str) -> str:
    output: list[str] = []
    paragraph: list[str] = []
    list_open = False
    table_lines: list[str] = []

    def flush_paragraph() -> None:
        nonlocal paragraph
        if paragraph:
            output.append(f"<p>{escape(' '.join(paragraph))}</p>")
            paragraph = []

    def flush_list() -> None:
        nonlocal list_open
        if list_open:
            output.append("</ul>")
            list_open = False

    def flush_table() -> None:
        nonlocal table_lines
        if table_lines:
            output.append(render_table(table_lines))
            table_lines = []

    for raw_line in text.splitlines():
        line = raw_line.rstrip()
        if line.strip().startswith("|") and line.strip().endswith("|"):
            flush_paragraph()
            flush_list()
            table_lines.append(line)
            continue
        flush_table()

        if not line.strip():
            flush_paragraph()
            flush_list()
            continue

        heading = re.match(r"^(#{1,6})\s+(.*)$", line)
        if heading:
            flush_paragraph()
            flush_list()
            level = min(len(heading.group(1)) + 1, 6)
            output.append(f"<h{level}>{escape(heading.group(2))}</h{level}>")
            continue

        bullet = re.match(r"^\s*[-*]\s+(.*)$", line)
        if bullet:
            flush_paragraph()
            if not list_open:
                output.append("<ul>")
                list_open = True
            output.append(f"<li>{escape(bullet.group(1))}</li>")
            continue

        paragraph.append(line.strip())

    flush_table()
    flush_paragraph()
    flush_list()
    return "\n".join(output)


def yaml_block(name: str) -> str:
    block = top_level_block(name, state_text)
    if not block.strip():
        block = "尚未記錄"
    return block


def panel(title: str, body: str, *, panel_id: str = "") -> str:
    id_attr = f' id="{escape(panel_id)}"' if panel_id else ""
    return f"""
    <section class="panel"{id_attr}>
      <h2>{escape(title)}</h2>
      {body}
    </section>
    """


def yaml_panel(name: str, title: str, *, panel_id: str = "") -> str:
    return panel(title, f"<pre>{escape(yaml_block(name))}</pre>", panel_id=panel_id)


def compact_text(text: str, limit: int = 72) -> str:
    normalized = re.sub(r"\s+", " ", text).strip()
    if not normalized:
        return "未記錄"
    if len(normalized) <= limit:
        return normalized
    return normalized[: limit - 1].rstrip() + "..."


def count_keywords(text: str, *keywords: str) -> int:
    return sum(len(re.findall(rf"\b{re.escape(keyword)}\b", text, re.IGNORECASE)) for keyword in keywords)


def extract_md_section(title_patterns: tuple[str, ...]) -> str:
    lines = status_text.splitlines()
    capture = False
    captured: list[str] = []
    for line in lines:
        heading = re.match(r"^(#{1,6})\s+(.*)$", line)
        if heading:
            title = heading.group(2).strip().lower()
            if capture:
                break
            capture = any(pattern in title for pattern in title_patterns)
            continue
        if capture:
            captured.append(line)
    return "\n".join(captured).strip()


status_html = render_markdown(status_text)
execution_block = yaml_block("execution_view")
context_block = yaml_block("context_view")
risk_block = yaml_block("risk_view")
activity_block = yaml_block("activity_view")
next_actions_text = extract_md_section(("next", "下一步", "todo", "action")) or "尚未整理。請由 AI 依目前專案狀態補入下一步。"

completed_count = count_keywords(execution_block, "completed", "done")
active_count = count_keywords(execution_block, "active", "executing")
pending_validation_count = count_keywords(execution_block, "pending")
risk_count = count_keywords(risk_block, "severity", "risk")
task_done_count = count_keywords(execution_block, "done", "completed")

main_panels = [
    yaml_panel("execution_view", "Milestone Progress", panel_id="milestone-progress"),
    panel("Pending Validations", f"<pre>{escape(execution_block)}</pre>", panel_id="pending-validations"),
    yaml_panel("risk_view", "Risks", panel_id="risks"),
    yaml_panel("debt_view", "Technical Debt", panel_id="technical-debt"),
    yaml_panel("activity_view", "Recent Handoffs & Activity", panel_id="recent-handoffs-activity"),
    panel("Current Status Markdown", status_html, panel_id="current-status"),
    panel("Project State YAML", f"<pre>{escape(state_text)}</pre>", panel_id="project-state-yaml"),
]

side_panels = [
    panel("Next Actions", render_markdown(next_actions_text), panel_id="next-actions"),
    panel("Observations", f"<pre>{escape(context_block)}</pre>", panel_id="observations"),
    panel("Future Options", f"<pre>{escape(context_block)}</pre>", panel_id="future-options"),
    panel("Pending Decisions", f"<pre>{escape(context_block)}</pre>", panel_id="pending-decisions"),
]

html = f"""<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{escape(project_name)} - Project Report</title>
<style>
  :root {{
    --bg:#f1f5f9; --surface:#fff; --surface-2:#f8fafc;
    --text:#0f172a; --muted:#64748b; --line:#e2e8f0;
    --teal:#0d9488; --blue:#2563eb; --amber:#d97706; --red:#dc2626; --green:#16a34a; --slate:#475569;
    --green-soft:#dcfce7; --amber-soft:#fef3c7; --red-soft:#fee2e2;
    --t-meta:1rem; --t-body:1.067rem; --t-item:1.2rem; --t-h3:1.333rem; --t-h2:1.467rem; --t-h1:2rem;
  }}
  *{{box-sizing:border-box}}
  html{{font-size:15px}}
  body{{margin:0;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--text);background:var(--bg);font-size:var(--t-body);line-height:1.6}}
  .wrap{{max-width:1280px;margin:0 auto;padding:1.5rem}}
  header{{background:var(--surface);border-bottom:1px solid var(--line)}}
  h1{{margin:0;font-size:var(--t-h1);font-weight:700;letter-spacing:0}}
  h2{{margin:0 0 1rem;font-size:var(--t-h2);font-weight:700;color:var(--slate);text-transform:uppercase;letter-spacing:.04em}}
  h3{{margin:1rem 0 .375rem;font-size:var(--t-h3);font-weight:600}}
  p{{margin:.5rem 0;line-height:1.65}}
  .sub{{color:var(--muted);font-size:var(--t-body);margin-top:.5rem}}
  .meta-row{{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.875rem;font-size:var(--t-meta);color:var(--muted)}}
  .meta-row span{{background:var(--surface-2);border:1px solid var(--line);border-radius:999px;padding:.375rem .75rem}}
  .kpis{{display:grid;grid-template-columns:repeat(6,1fr);gap:.75rem;margin:1.25rem 0 0}}
  .kpi{{background:var(--surface);border:1px solid var(--line);border-radius:.5rem;padding:1rem;display:flex;flex-direction:column;gap:.625rem;min-width:0}}
  .kpi .label{{color:var(--muted);font-size:var(--t-meta);line-height:1;height:1.125rem;display:flex;align-items:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}}
  .kpi .value{{font-size:var(--t-h1);font-weight:700;color:var(--text);line-height:1;height:2.25rem;display:inline-flex;align-items:center}}
  .kpi .delta{{color:var(--muted);font-size:var(--t-meta);line-height:1;height:1.125rem;display:flex;align-items:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}}
  .kpi.ok .value{{color:var(--green)}}
  .kpi.warn .value{{color:var(--amber)}}
  .kpi.danger .value{{color:var(--red)}}
  .toolbar{{margin:0 0 1rem}}
  input[type="search"]{{width:100%;border:1px solid var(--line);border-radius:.5rem;padding:.75rem .875rem;font-size:1rem;background:var(--surface)}}
  main{{display:grid;grid-template-columns:1fr 20rem;gap:1.25rem;margin-top:1.25rem}}
  .panel{{background:var(--surface);border:1px solid var(--line);border-radius:.625rem;padding:1.125rem;margin-bottom:.875rem}}
  .panel[hidden]{{display:none}}
  aside .panel{{padding:1rem}}
  pre{{white-space:pre-wrap;overflow-wrap:anywhere;background:var(--surface-2);border:1px solid var(--line);color:var(--slate);padding:1rem;border-radius:.5rem;overflow:auto;font-size:.95rem;line-height:1.55}}
  code{{background:#eef2f7;padding:.125rem .375rem;border-radius:.25rem}}
  table{{width:100%;border-collapse:collapse;font-size:.95rem}}
  th,td{{border:1px solid var(--line);padding:.5rem;text-align:left;vertical-align:top}}
  th{{background:var(--surface-2)}}
  .table-wrap{{overflow-x:auto}}
  ul,ol{{padding-left:1.25rem}}
  li{{margin:.25rem 0}}
  footer{{color:var(--muted);font-size:var(--t-meta);padding:1.125rem 0;text-align:center}}
  @media (max-width:1000px){{.kpis{{grid-template-columns:repeat(3,1fr)}}main{{grid-template-columns:1fr}}aside .panel{{padding:.875rem}}}}
  @media (max-width:620px){{.wrap{{padding:1rem}}.kpis{{grid-template-columns:1fr 1fr}}}}
</style>
</head>
<body>
<header>
  <div class="wrap">
    <h1>{escape(project_name)} <span style="color:var(--muted);font-weight:500;font-size:var(--t-h3)">- Project Report</span></h1>
    <p class="sub">{escape(project_goal)}</p>
    <div class="meta-row">
      <span>source_summarized_at: {escape(source_summarized_at)}</span>
      <span>generated_at: {escape(generated_at)}</span>
      <span>updated_at: {escape(updated_at)}</span>
      <span>current_status: {escape(current_status)}</span>
      <span>current_milestone: {escape(current_milestone)}</span>
    </div>
    <div class="kpis">
      <div class="kpi ok">
        <div class="label">已完成項目</div>
        <div class="value">{completed_count or "—"}</div>
        <div class="delta">execution_view snapshot</div>
      </div>
      <div class="kpi">
        <div class="label">作用中項目</div>
        <div class="value">{active_count or "—"}</div>
        <div class="delta">{escape(compact_text(current_milestone, 24))}</div>
      </div>
      <div class="kpi warn">
        <div class="label">待驗證</div>
        <div class="value">{pending_validation_count or "—"}</div>
        <div class="delta">validations / pending</div>
      </div>
      <div class="kpi danger">
        <div class="label">風險紀錄</div>
        <div class="value">{risk_count or "—"}</div>
        <div class="delta">risk_view snapshot</div>
      </div>
      <div class="kpi">
        <div class="label">資料彙整</div>
        <div class="value">YML</div>
        <div class="delta">{escape(source_summarized_at)}</div>
      </div>
      <div class="kpi">
        <div class="label">狀態輸出</div>
        <div class="value">MD</div>
        <div class="delta">{escape(compact_text(current_status, 24))}</div>
      </div>
    </div>
  </div>
</header>

<main class="wrap">
  <div>
    <div class="toolbar"><input id="filter" type="search" placeholder="Filter report text..."></div>
    {''.join(main_panels)}
  </div>
  <aside>
    {''.join(side_panels)}
  </aside>
</main>

<div class="wrap">
  <footer>
    Source: <code>vibe-coding/reports/data/project-state.yml</code> + <code>vibe-coding/reports/current-status.md</code>.
    HTML is a static snapshot; regenerate it when the source summary changes.
  </footer>
</div>

<script>
  const filter = document.getElementById('filter');
  const sections = Array.from(document.querySelectorAll('.panel'));
  filter.addEventListener('input', () => {{
    const q = filter.value.trim().toLowerCase();
    for (const section of sections) {{
      const text = section.innerText.toLowerCase();
      section.hidden = q && !text.includes(q);
    }}
  }});
</script>
</body>
</html>
"""

html_path.write_text(html, encoding="utf-8")
print(html_path)
PY
}

main() {
  ensure_report_source_files
  local html_path
  html_path="$(render_dashboard)"
  print_line "報告已產生：${html_path}"
  if [[ "${OPEN_AFTER_GENERATE}" == "true" ]]; then
    open_dashboard "${html_path}"
  fi
}

main
